ifeq (,$(filter-out all rom compare modern,$(MAKECMDGOALS)))
$(call infoshell, $(MAKE) tools)
else
NODEP := 1
endif

C_SRCS_IN := $(wildcard $(C_SUBDIR)/*.c $(C_SUBDIR)/*/*.c $(C_SUBDIR)/*/*/*.c)
C_SRCS := $(foreach src,$(C_SRCS_IN),$(if $(findstring .inc.c,$(src)),,$(src)))
# R7B/R8/R9: the trainer + Pokémon battle payload TUs are GBA-only -
# trainers_front_payload.c (all 93 sheets + 93 palettes), trainers_back_payload.c
# (the 8 back sheets + the 2 Red/Leaf back-only palettes), and the Pokémon
# battle leaves (anim_mon_front_pics.c: all 416 front pics;
# pokemon_battle_payload.c: the 1192 back/palette/shiny leaves incl. the
# slot-0 circled-question-mark trio). The native target excludes them so the
# migrated leaf symbols and bytes never enter the native object/link graph
# (see src/data/graphics/trainers_front_payload.c). The GBA Makefile
# auto-collects them via its own wildcard.
ifeq ($(NATIVE_LINUX),1)
C_SRCS := $(filter-out $(C_SUBDIR)/data/graphics/trainers_front_payload.c \
                       $(C_SUBDIR)/data/graphics/trainers_back_payload.c \
                       $(C_SUBDIR)/data/graphics/pokemon_battle_payload.c \
                       $(C_SUBDIR)/anim_mon_front_pics.c,$(C_SRCS))
endif
C_OBJS := $(patsubst $(C_SUBDIR)/%.c,$(C_BUILDDIR)/%.o,$(C_SRCS))

GFLIB_SRCS := $(wildcard $(GFLIB_SUBDIR)/*.c)
GFLIB_OBJS := $(patsubst $(GFLIB_SUBDIR)/%.c,$(GFLIB_BUILDDIR)/%.o,$(GFLIB_SRCS))

C_ASM_SRCS += $(wildcard $(C_SUBDIR)/*.s $(C_SUBDIR)/*/*.s $(C_SUBDIR)/*/*/*.s)
C_ASM_OBJS := $(patsubst $(C_SUBDIR)/%.s,$(C_BUILDDIR)/%.o,$(C_ASM_SRCS))

ASM_SRCS := $(wildcard $(ASM_SUBDIR)/*.s)
ASM_OBJS := $(patsubst $(ASM_SUBDIR)/%.s,$(ASM_BUILDDIR)/%.o,$(ASM_SRCS))

# get all the data/*.s files EXCEPT the ones with specific rules
REGULAR_DATA_ASM_SRCS := $(filter-out $(DATA_ASM_SUBDIR)/maps.s $(DATA_ASM_SUBDIR)/map_events.s, $(wildcard $(DATA_ASM_SUBDIR)/*.s))

DATA_ASM_SRCS := $(wildcard $(DATA_ASM_SUBDIR)/*.s)
DATA_ASM_OBJS := $(patsubst $(DATA_ASM_SUBDIR)/%.s,$(DATA_ASM_BUILDDIR)/%.o,$(DATA_ASM_SRCS))

SONG_SRCS := $(wildcard $(SONG_SUBDIR)/*.s)
SONG_OBJS := $(patsubst $(SONG_SUBDIR)/%.s,$(SONG_BUILDDIR)/%.o,$(SONG_SRCS))

MID_SRCS := $(wildcard $(MID_SUBDIR)/*.mid)
MID_OBJS := $(patsubst $(MID_SUBDIR)/%.mid,$(MID_BUILDDIR)/%.o,$(MID_SRCS))

# R12-G: the 64-bit native linux link drops every compiled audio payload
# object (530 song objects; the data/sound_data.s payload includes are also
# excluded via the NATIVE_LINUX/LINUX64 assembly gates). The GBA build and
# the 32-bit/windows native builds keep the full payload set - SONG_OBJS /
# MID_OBJS above are computed from the (unchanged) source wildcards, and the
# assembly rules in audio_rules.mk still generate the midi-derived objects
# for them; for the linux64 link these lists are simply empty, so no rule
# fires and no payload object is linked.
ifeq ($(NATIVE_LINUX)-$(LINUX64),1-1)
SONG_OBJS :=
MID_OBJS :=

# R12-G: sweep stale audio payload objects out of the linux64 object tree.
# make only deletes targets it would rebuild; with SONG_OBJS/MID_OBJS empty,
# song objects from a pre-R12-G (payload-linked) build would linger in
# build/linux64/sound/songs and the isolation runner - which treats the
# object tree as the link graph and refuses any ROM_BASE_ONLY symbol in any
# object - would fail on them. Nothing in the linux64 build references these
# dirs; the other targets keep their own.
.PHONY: sweep-stale-audio-objects
sweep-stale-audio-objects:
	rm -rf $(OBJ_DIR)/$(SONG_SUBDIR) $(OBJ_DIR)/$(MID_SUBDIR)

rom: sweep-stale-audio-objects
endif

OBJS     := $(C_OBJS) $(GFLIB_OBJS) $(ASM_OBJS) $(DATA_ASM_OBJS) $(SONG_OBJS) $(MID_OBJS)
ifeq ($(NATIVE_LINUX),0)
WINDOWS_RESOURCE_OBJ := $(OBJ_DIR)/pokemon_emerald_icon.o
OBJS += $(WINDOWS_RESOURCE_OBJ)
endif
OBJS_REL := $(patsubst $(OBJ_DIR)/%,%,$(OBJS))

SUBDIRS  := $(sort $(dir $(OBJS)))

$(shell mkdir -p $(SUBDIRS))

